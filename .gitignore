# Erzeugtes
dist/
bin/
obj/
.pio/
build/
*.o
*.hex
*.uf2

# Laufzeitdaten - Ausnahme: Firmware-Dateisystem
apps/*/data/
!apps/firmware*/data/

# Echte Konfiguration und Secrets - nur *.example kommt ins Repo
apps/*/config/*
!apps/*/config/*.example
apps/firmware*/include/config.h

# Fremdcode per Paketmanager
apps/*/vendor/
node_modules/

# Signaturschluessel gehoeren nie ins Repo
*.pem
*.key

# EasyEDA legt bei jedem Speichern eine Sicherung mit Zeitstempel an -
# die waechst endlos. Die Projektdatei selbst gehoert sehr wohl ins Repo.
hardware/opensecurekey_backup/

# EasyEDAs lokale Projektdatei wird nicht bei jeder Aenderung nachgezogen.
# Sie laeuft hier nur mit, wenn jemand im Editor speichert - die Brueckenarbeit
# allein erreicht sie nicht. Eine alte Fassung sieht aus wie eine Sicherung und
# ist keine. Darum: nicht blind einchecken, sondern frisch erzeugen und danach
# pruefen, ob die zuletzt geaenderten Teile wirklich drinstehen.
# Fuer den laufenden Stand gilt der Export ueber die Bruecke
# (hardware/schematic-source-*.txt), der liegt im Repo.
hardware/opensecurekey.eprj2
