# Erzeugtes
dist/
bin/
obj/
.pio/
build/
*.o
*.hex
*.uf2

# Laufzeitdaten - Ausnahme: Firmware-Dateisystem
apps/*/data/
!apps/firmware*/data/

# Echte Konfiguration und Secrets - nur *.example kommt ins Repo
apps/*/config/*
!apps/*/config/*.example
apps/firmware*/include/config.h

# Fremdcode per Paketmanager
apps/*/vendor/
node_modules/

# Signaturschluessel gehoeren nie ins Repo. Wer einen hat, baut Firmware, die
# JEDES Geraet annimmt - und aus der Geschichte ist er nicht mehr
# herauszuholen.
#
# Diese Liste ist die ERSTE von drei Schichten und die schwaechste: sie kennt
# nur Namen, die hier schon aufgeschrieben sind. Eine Datei namens
# "firmware-schluessel.txt" faellt durch jede Zeile darunter, und ein
# "git add -f" ueberfaehrt die ganze Datei. Darum sieht tools/keyguard.py nach,
# was WIRKLICH im Ordner liegt - nach Inhalt, nicht nach Namen -, und
# tools/sign.py benutzt keinen Schluessel aus dem Projektordner, auch keinen
# ausdruecklich genannten. Siehe docs/signatur.md.
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.der
*.priv
*.gpg
*.asc
id_rsa
id_dsa
id_ecdsa
id_ed25519
*-private-key*
*-privkey*
*-secret-key*
*-signing-key*
.osk-keys/
# Der OEFFENTLICHE Teil gehoert sehr wohl ins Repo - der Bootloader braucht
# ihn (tools/sign.py --pubkey-c).
!*.pub
!*-public*.pem

# EasyEDA legt bei jedem Speichern eine Sicherung mit Zeitstempel an -
# die waechst endlos. Die Projektdatei selbst gehoert sehr wohl ins Repo.
hardware/opensecurekey_backup/

# EasyEDAs lokale Projektdatei wird nicht bei jeder Aenderung nachgezogen.
# Sie laeuft hier nur mit, wenn jemand im Editor speichert - die Brueckenarbeit
# allein erreicht sie nicht. Eine alte Fassung sieht aus wie eine Sicherung und
# ist keine. Darum: nicht blind einchecken, sondern frisch erzeugen und danach
# pruefen, ob die zuletzt geaenderten Teile wirklich drinstehen.
# Fuer den laufenden Stand gilt der Export ueber die Bruecke
# (hardware/schematic-source-*.txt), der liegt im Repo.
hardware/opensecurekey.eprj2

# Von Python beim Uebersetzen abgelegt. Am 29.10.2026 versehentlich
# mitgekommen, als ich die Platinen-Skripte nur auf Uebersetzbarkeit geprueft
# habe - die Pruefung selbst hat die Dateien erzeugt.
__pycache__/
*.pyc

# Legt der Windows-Explorer in Ordnern mit Bildern ab, auf dem NAS besonders
# gern. Gehoert niemandem und sagt nichts.
Thumbs.db
